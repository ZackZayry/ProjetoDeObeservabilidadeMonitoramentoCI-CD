<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Valores vindos do application.properties / variáveis de ambiente -->
    <springProperty scope="context" name="graylogHost" source="graylog.host" defaultValue="localhost"/>
    <springProperty scope="context" name="graylogPort" source="graylog.port" defaultValue="12201"/>
    <springProperty scope="context" name="graylogProtocol" source="graylog.protocol" defaultValue="udp"/>

    <!-- Console padrão do Spring Boot (sempre ativo; útil em `docker logs` e na IDE) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Logs da aplicação em DEBUG (detalhes técnicos); o restante fica em INFO -->
    <logger name="br.edu.ifc.bikes" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!--
      Envio para o Graylog (GELF) SOMENTE com o perfil "graylog" ativo
      (o docker-compose já ativa: SPRING_PROFILES_ACTIVE=mysql,graylog).
      Sem o Graylog no ar, o UDP recebe "port unreachable" e o logback imprime um
      PortUnreachableException a cada linha de log. Rodando pela IDE, ative o perfil
      só depois de subir o Graylog (docker compose up -d graylog ...).
    -->
    <springProfile name="graylog">
        <appender name="GELF" class="biz.paluch.logging.gelf.logback.GelfLogbackAppender">
            <host>${graylogProtocol}:${graylogHost}</host>
            <port>${graylogPort}</port>
            <version>1.1</version>
            <facility>bikes-api</facility>
            <extractStackTrace>true</extractStackTrace>
            <filterStackTrace>true</filterStackTrace>
            <includeFullMdc>true</includeFullMdc>
            <maximumMessageSize>8192</maximumMessageSize>
            <additionalFields>application=bikes-api,ambiente=academico</additionalFields>
        </appender>

        <!-- Assíncrono: se o Graylog cair, a API não fica lenta nem trava -->
        <appender name="GELF_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="GELF"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="GELF_ASYNC"/>
        </root>
    </springProfile>

</configuration>
